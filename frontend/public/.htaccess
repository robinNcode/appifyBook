# SPA fallback for React Router when the app is served from /appifybook/.
# Any request that isn't a real file or directory is handed to index.html
# so client-side routes (e.g. /appifybook/feed) resolve on refresh/deep-link.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /appifybook/

  # Serve existing files and directories as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else -> index.html
  RewriteRule ^ index.html [L]
</IfModule>
